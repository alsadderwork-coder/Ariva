<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Curated from AMAN's Directory.Packages.props. Versions are copied exactly from AMAN; bump them in step with AMAN. -->
  <ItemGroup>
    <!-- Microsoft Feature Management -->
    <PackageVersion Include="Microsoft.FeatureManagement.AspNetCore" Version="4.4.0" />
    <!-- Messaging (ADR-0018): MassTransit 8 with the Kafka Rider, AMAN parity. 8.5.11 is the latest Apache 2.0 release
         (2026-09-30) and needs Confluent.Kafka 2.15.1 or later. Never move to 9.x without a licence decision. -->
    <PackageVersion Include="MassTransit" Version="8.5.11" />
    <PackageVersion Include="MassTransit.Kafka" Version="8.5.11" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.1" />
    <!-- ASP.NET Core and Microsoft Extensions, .NET 10 -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.1.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <!-- API Versioning and OpenAPI UI -->
    <PackageVersion Include="Asp.Versioning.Http" Version="8.1.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.11.7" />
    <!-- Database: NHibernate over PostgreSQL with TimescaleDB -->
    <PackageVersion Include="NHibernate" Version="5.6.0" />
    <PackageVersion Include="Npgsql" Version="10.0.0" />
    <PackageVersion Include="Npgsql.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.0" />
    <!-- Entity Framework Core: only for the TickerQ operational store (domain persistence stays on NHibernate) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Utilities and Libraries -->
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
    <PackageVersion Include="ConfigurationSubstitutor" Version="1.5.1" />
    <PackageVersion Include="Cronos" Version="0.11.1" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Fluentx" Version="6.1.9" />
    <PackageVersion Include="Handlebars.Net" Version="2.1.6" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.1" />
    <PackageVersion Include="MailKit" Version="4.14.1" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <PackageVersion Include="MessagePack" Version="3.1.7" />
    <PackageVersion Include="Polly" Version="8.6.5" />
    <PackageVersion Include="PuppeteerSharp" Version="20.2.5" />
    <!-- System / BCL, .NET 10 -->
    <PackageVersion Include="System.Threading.Channels" Version="10.0.12" />
    <!-- Microsoft.CodeAnalysis -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
    <!-- ML.NET (forecasting) -->
    <PackageVersion Include="Microsoft.ML" Version="4.0.2" />
    <PackageVersion Include="Microsoft.ML.TimeSeries" Version="4.0.2" />
    <!-- Redis -->
    <PackageVersion Include="StackExchange.Redis" Version="2.10.1" />
    <!-- FusionCache -->
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.4.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.4.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.4.0" />
    <!-- TickerQ -->
    <PackageVersion Include="TickerQ" Version="10.0.2" />
    <PackageVersion Include="TickerQ.Dashboard" Version="10.0.2" />
    <PackageVersion Include="TickerQ.Caching.StackExchangeRedis" Version="10.0.2" />
    <PackageVersion Include="TickerQ.Instrumentation.OpenTelemetry" Version="10.0.2" />
    <PackageVersion Include="TickerQ.EntityFrameworkCore" Version="10.0.2" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />
    <!-- Serilog -->
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Grafana.Loki" Version="8.3.1" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Testing Frameworks -->
    <PackageVersion Include="xunit.v3" Version="3.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>
  <!--
    Packages that backlog stories will add later. They are not in AMAN's file, so no version is pinned yet.
    Add a PackageVersion entry for each one in the story that first uses it:
      Testcontainers.PostgreSql   (version to pin when added)
      Testcontainers.Kafka        (version to pin when added)
      Testcontainers.Redis        (version to pin when added)
  -->
</Project>
