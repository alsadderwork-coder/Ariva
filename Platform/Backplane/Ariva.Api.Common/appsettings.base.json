{
  "Application": {
    "ProjectCode": "ariva",
    "BindingHost": "localhost",
    "BindingPort": 8080,
    "Domain": "localhost",
    "Environment": "vm-local",
    "IsHighAvailable": false,
    "Mode": "Default",
    "Name": "api-${Application:ShortName}",
    "ShortName": "base"
  },
  "Cache": {
    "FusionCacheInMinutes": 5,
    "DefaultDurationSeconds": 300,
    "UseDistributedCache": true
  },
  "Crons": {
    "Enabled": true
  },
  "Database": {
    "StorageProvider": "nhibernate",
    "AllowSchemaUpdate": false,
    "VerifySchemaOnStartup": true,
    "Host": "localhost",
    "Migration": {
      "Password": "",
      "Username": "ariva"
    },
    "NHibernate": {
      "CascadeToReadonlyTypes": false,
      "ConnectionDriver": "Ariva.Infra.NHibernate.Drivers.NHibernatePostgresClientDriver, Ariva.Infra",
      "ConnectionProvider": "NHibernate.Connection.DriverConnectionProvider, NHibernate",
      "Dialect": "NHibernate.Dialect.PostgreSQL83Dialect",
      "UseSecondLevelCache": false
    },
    "Name": "ariva",
    "Password": "",
    "Port": 5432,
    "UseEncryption": false,
    "Username": "ariva_app"
  },
  "Auth": {
    "Tokens": {
      "Issuer": "ariva",
      "Audience": "ariva-users",
      "LifetimeMinutes": 15,
      "ClockSkewSeconds": 30,
      "SigningKeyPath": "",
      "PublicKeyPaths": [],
      "UseDevelopmentKeys": false
    },
    "Lockout": {
      "Threshold": 10,
      "DurationSeconds": 900
    },
    "Sessions": {
      "AbsoluteSeconds": 43200,
      "IdleSecondsAdministrator": 1800,
      "IdleSecondsOperational": 14400,
      "RefreshGraceSeconds": 30,
      "CacheSeconds": 4
    },
    "Totp": {
      "Issuer": "Ariva",
      "SkewSteps": 1,
      "BreakGlassUserName": "break-glass"
    },
    "TotpRequired": true,
    "ContextWords": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "NHibernate": "Warning",
        "System": "Warning"
      }
    }
  },
  "Loki": {
    "Enabled": false,
    "Uri": ""
  },
  "Otlp": {
    "Enabled": false,
    "Endpoint": "",
    "Protocol": "grpc"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "TopicPrefix": "ariva"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "ariva:"
  },
  "DataProtection": {
    "CertificatePath": "",
    "KeyPath": "",
    "UseDevelopmentCertificate": false
  },
  "Timescale": {
    "Enabled": true
  },
  "Microservices": {
    "Main": {
      "External": "http://localhost:51001",
      "Internal": "http://localhost:51001"
    },
    "Ingest": {
      "External": "http://localhost:51002",
      "Internal": "http://localhost:51002"
    },
    "Stream": {
      "External": "http://localhost:51003",
      "Internal": "http://localhost:51003"
    },
    "Cronz": {
      "External": "http://localhost:51004",
      "Internal": "http://localhost:51004"
    },
    "Integration": {
      "External": "http://localhost:51005",
      "Internal": "http://localhost:51005"
    }
  },
  "Security": {
    "Limits": {
      "MaxRequestBodyBytes": 1048576,
      "MaxRequestLineBytes": 8192,
      "MaxRequestHeadersTotalBytes": 32768,
      "MaxRequestHeaderCount": 64,
      "MaxFormValueCount": 1024,
      "MaxFormValueLengthBytes": 65536,
      "MaxFormKeyLengthBytes": 2048,
      "MaxJsonDepth": 32,
      "RequestHeadersTimeoutSeconds": 15
    },
    "RateLimiting": {
      "Global": {
        "PermitLimit": 1000,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Auth": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    },
    "ForwardedHeaders": {
      "ForwardLimit": 1,
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "Cors": {
      "AllowedOrigins": [],
      "AllowCredentials": true,
      "PreflightMaxAgeSeconds": 600
    }
  }
}
