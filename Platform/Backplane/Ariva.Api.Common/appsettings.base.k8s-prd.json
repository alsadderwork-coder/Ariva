{
  "Application": {
    "BindingHost": "0.0.0.0",
    "Domain": "dalilhub.tech",
    "Environment": "k8s-prd",
    "IsHighAvailable": true
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:8443",
        "SslProtocols": [
          "Tls12",
          "Tls13"
        ],
        "Certificate": {
          "Path": "/app/secrets/pod-tls/tls.crt",
          "KeyPath": "/app/secrets/pod-tls/tls.key"
        }
      }
    }
  },
  "Database": {
    "Host": "timescaledb",
    "Password": "",
    "UseEncryption": true,
    "RootCertificate": "/app/secrets/database-ca/ca.crt",
    "Username": "ariva_app",
    "Migration": {
      "Password": "",
      "Username": "ariva"
    }
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "kafka:9092",
    "Topics": {
      "ReplicationFactor": 3,
      "MinInSyncReplicas": 2
    },
    "SecurityProtocol": "SaslSsl",
    "SaslMechanism": "ScramSha512",
    "SaslUsername": "ariva",
    "SslCaLocation": "/app/secrets/kafka-ca/ca.crt"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "redis:6379,ssl=true",
    "CaCertificatePath": "/app/secrets/redis-ca/ca.crt"
  },
  "DataProtection": {
    "CertificatePath": "/app/secrets/dataprotection/tls.crt",
    "KeyPath": "/app/secrets/dataprotection/tls.key"
  },
  "Microservices": {
    "Main": {
      "External": "https://api-main-ariva.dalilhub.tech",
      "Internal": "https://api-main-service"
    },
    "Ingest": {
      "External": "https://api-ingest-ariva.dalilhub.tech",
      "Internal": "https://api-ingest-service"
    },
    "Stream": {
      "External": "https://api-stream-service",
      "Internal": "https://api-stream-service"
    },
    "Cronz": {
      "External": "https://api-cronz-ariva.dalilhub.tech",
      "Internal": "https://api-cronz-service"
    },
    "Integration": {
      "External": "https://api-integration-ariva.dalilhub.tech",
      "Internal": "https://api-integration-service"
    }
  },
  "Security": {
    "Cors": {
      "AllowedOrigins": [
        "https://ariva.dalilhub.tech"
      ]
    }
  },
  "Auth": {
    "Tokens": {
      "PublicKeyPaths": [
        "/app/secrets/token-public/public.pem",
        "/app/secrets/token-public/previous.pem"
      ]
    }
  }
}
