{
  "Application": {
    "Environment": "vm-local",
    "Domain": "localhost"
  },
  "Database": {
    "AllowSchemaUpdate": true,
    "VerifySchemaOnStartup": false,
    "Host": "localhost",
    "Port": 5433,
    "Username": "ariva_app",
    "Password": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092"
  },
  "Redis": {
    "ConnectionString": "localhost:16379"
  },
