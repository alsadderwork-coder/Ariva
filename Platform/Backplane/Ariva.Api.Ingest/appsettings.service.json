{
  "Application": {
    "ShortName": "ingest",
    "BindingPort": 51002
  },
  "Database": {
    "MaxPoolSize": 26
  },
  "Kafka": {
    "ServiceName": "ingest"
  },
  "Security": {
    "RateLimiting": {
      "Global": {
        "PermitLimit": 20000,
        "WindowSeconds": 60
