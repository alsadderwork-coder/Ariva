      "Device": {
        "PermitLimit": 600,
        "WindowSeconds": 60
      }
    },
    "ClientCertificates": {
      "ForwardedHeader": ""
    }
  },
  "Ingest": {
    "MaxEventsPerMessage": 2000
  }
}
