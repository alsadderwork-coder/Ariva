<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Microsoft Testing Platform in the test executable (ARV-164b): the integration gate and CI run it as the unit suite
             runs (scripts/verify.mjs), since under dotnet test the hosts' console logs share the xUnit runner's message
             stream, which the VSTest adapter reads and from which it drops a line it cannot read (ARV-164). -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <!-- ARV-139c: the development-only NBJ-BC1 seed and its tests exist in Debug builds only (Ariva.Infra.csproj). -->
    <PropertyGroup Label="Development-only seed" Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>$(DefineConstants);ARIVA_DEV_SEED</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Apizr" />
        <PackageReference Include="AutoFixture" />
        <PackageReference Include="Bogus" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <!-- The advertisement image re-encoder (ARV-142a) with its Linux native library, as Ariva.Api.Main ships it -->
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="Testcontainers.Redis" />
        <PackageReference Include="Testcontainers.Kafka" />
        <PackageReference Include="Testcontainers.Toxiproxy" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\GlobalSuppressions.cs" Link="GlobalSuppressions.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- ARV-142b: the advertisement video fixtures (Platform/Testing/Media/README.md says how they were made). -->
        <Content Include="..\..\Testing\Media\*.mp4;..\..\Testing\Media\*.webm">
            <Link>Media\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.json">
            <Link>appsettings.base.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.vm-local.json">
            <Link>appsettings.base.vm-local.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.k8s-dev.json">
            <Link>appsettings.base.k8s-dev.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.k8s-demo.json">
            <Link>appsettings.base.k8s-demo.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.k8s-prd.json">
            <Link>appsettings.base.k8s-prd.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ariva.Core\Ariva.Core.csproj" />
        <ProjectReference Include="..\Ariva.Infra\Ariva.Infra.csproj" />
        <ProjectReference Include="..\Ariva.Di\Ariva.Di.csproj" />
        <ProjectReference Include="..\Ariva.Api.Common\Ariva.Api.Common.csproj" />
        <ProjectReference Include="..\..\Business\Ariva.Business.Contracts\Ariva.Business.Contracts.csproj" />
        <!-- ARV-126: the restore test starts these hosts on a restored database (WebApplicationFactory, k8s-dev). -->
        <ProjectReference Include="..\Ariva.Api.Main\Ariva.Api.Main.csproj" />
        <ProjectReference Include="..\Ariva.Api.Integration\Ariva.Api.Integration.csproj" />
        <!-- ARV-036: the reference evening (sensor emulator, Ingest) for the golden replay over the archive. -->
        <ProjectReference Include="..\..\Simulation\Ariva.Simulation.Api\Ariva.Simulation.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Ariva.UnitTests\Replay\ReferenceReplay.cs" Link="Replay\ReferenceReplay.cs" />
        <Compile Include="..\Ariva.UnitTests\Setup\RepositoryPaths.cs" Link="Replay\RepositoryPaths.cs" />
        <!-- ARV-092b: the EICAR test file built at run time and the fake clamd, for the upload services' scan tests. -->
        <Compile Include="..\Ariva.UnitTests\Setup\Eicar.cs" Link="Setup\Eicar.cs" />
        <Compile Include="..\Ariva.UnitTests\Setup\FakeClamd.cs" Link="Setup\FakeClamd.cs" />
    </ItemGroup>

</Project>
