<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- PACT_DO_NOT_TRACK for the Pact FFI (ARV-068) -->
        <RunSettingsFilePath>$(MSBuildProjectDirectory)/Ariva.UnitTests.runsettings</RunSettingsFilePath>
        <!-- Microsoft Testing Platform in the test executable (ARV-069): Stryker.NET's mtp runner activates mutants and
             captures coverage through it; dotnet test keeps running the tests through VSTest (xunit.runner.visualstudio). -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- ARV-096: one lock file per build platform, as Ariva.AppHost (its project file says why): the AppHost reference brings
             the Aspire dashboard and orchestrator packages of the building machine's platform. -->
        <NuGetLockFilePath>packages.$(NETCoreSdkPortableRuntimeIdentifier).lock.json</NuGetLockFilePath>
    </PropertyGroup>

    <!-- ARV-139c: the development-only NBJ-BC1 seed and its tests exist in Debug builds only (Ariva.Infra.csproj); a Release
         run proves its absence instead (NbjSiteScopeTests). -->
    <PropertyGroup Label="Development-only seed" Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>$(DefineConstants);ARIVA_DEV_SEED</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoFixture" />
        <!-- The Ariva.AppHost model, built in process (ARV-066) -->
        <PackageReference Include="Aspire.Hosting.Testing" />
        <!-- Lifts StreamJsonRpc's MessagePack (GHSA-qhrr-8q5h-9q3h below 2.5.303) to the patched version in Directory.Packages.props (ARV-096) -->
        <PackageReference Include="MessagePack" />
        <PackageReference Include="Bogus" />
        <!-- Property-based tests of the formulas and parsers (ARV-070) -->
        <PackageReference Include="CsCheck" />
        <!-- The advertisement image re-encoder (ARV-142a) with its Linux native library, as Ariva.Api.Main ships it -->
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <!-- Message pacts for AMAN's feed and their verification against the simulator's AMAN (ARV-068) -->
        <PackageReference Include="PactNet" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\GlobalSuppressions.cs" Link="GlobalSuppressions.cs" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Ariva.Api.Common\appsettings.base.json">
            <Link>appsettings.base.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.vm-local.json">
            <Link>appsettings.base.vm-local.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.k8s-dev.json">
            <Link>appsettings.base.k8s-dev.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.k8s-demo.json">
            <Link>appsettings.base.k8s-demo.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Infra\Timescale\Scripts\checksums.lock">
            <Link>checksums.lock</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Ariva.Api.Common\appsettings.base.k8s-prd.json">
            <Link>appsettings.base.k8s-prd.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <!-- ARV-142b: the advertisement video fixtures (Platform/Testing/Media/README.md says how they were made). -->
        <Content Include="..\..\Testing\Media\*.mp4;..\..\Testing\Media\*.webm">
            <Link>Media\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ariva.Core\Ariva.Core.csproj" />
        <ProjectReference Include="..\Ariva.Infra\Ariva.Infra.csproj" />
        <ProjectReference Include="..\Ariva.Resources\Ariva.Resources.csproj" />
        <ProjectReference Include="..\Ariva.Di\Ariva.Di.csproj" />
        <ProjectReference Include="..\Ariva.Api.Common\Ariva.Api.Common.csproj" />
        <ProjectReference Include="..\..\Business\Ariva.Business.Contracts\Ariva.Business.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ariva.Api.Main\Ariva.Api.Main.csproj" />
        <ProjectReference Include="..\Ariva.Api.Ingest\Ariva.Api.Ingest.csproj" />
        <ProjectReference Include="..\Ariva.Api.Stream\Ariva.Api.Stream.csproj" />
        <ProjectReference Include="..\Ariva.Api.Cronz\Ariva.Api.Cronz.csproj" />
        <ProjectReference Include="..\Ariva.Api.Integration\Ariva.Api.Integration.csproj" />
        <ProjectReference Include="..\..\Simulation\Ariva.Simulation.Api\Ariva.Simulation.Api.csproj" />
        <ProjectReference Include="..\..\Cloud\Ariva.AppHost\Ariva.AppHost.csproj" />
    </ItemGroup>

</Project>
