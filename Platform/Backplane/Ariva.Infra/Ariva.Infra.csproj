<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\GlobalSuppressions.cs" Link="GlobalSuppressions.cs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ariva.UnitTests" />
        <InternalsVisibleTo Include="Ariva.IntegrationTests" />
        <InternalsVisibleTo Include="Ariva.Di" />
    </ItemGroup>

    <ItemGroup>
        <!-- Persistence (ARV-005): NHibernate over Npgsql, AMAN versions -->
        <PackageReference Include="NHibernate" />
        <PackageReference Include="Npgsql" />
        <!-- Redis connection shared by the FusionCache levels (ARV-008) -->
        <PackageReference Include="StackExchange.Redis" />
        <!-- Accounts and tokens (ARV-010a): ES256 JWTs (Microsoft.IdentityModel through the JwtBearer package) and cached grants -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="ZiggyCreatures.FusionCache" />
        <!-- Messaging (ARV-020, ADR-0018): MassTransit 8 Kafka Rider, outbox, inbox, dead letters; raw Confluent consumer for Stream -->
        <PackageReference Include="MassTransit" />
        <PackageReference Include="MassTransit.Kafka" />
        <PackageReference Include="Confluent.Kafka" />
        <PackageReference Include="MailKit" />
    </ItemGroup>

    <ItemGroup>
        <!-- Versioned scripts ship inside the assembly, so the migration job and the startup check read exactly what was built (ARV-006) -->
        <EmbeddedResource Include="Timescale\Scripts\*.sql" LogicalName="Ariva.Infra.Timescale.Scripts.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Sensing\Mappings\*.json" LogicalName="Ariva.Infra.Sensing.Mappings.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Security\Resources\password-blocklist.txt.gz" LogicalName="Ariva.Infra.Security.password-blocklist.txt.gz" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ariva.Core\Ariva.Core.csproj" />
        <ProjectReference Include="..\Ariva.Resources\Ariva.Resources.csproj" />
    </ItemGroup>

</Project>
