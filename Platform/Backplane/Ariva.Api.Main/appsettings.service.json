{
  "Application": {
    "ShortName": "main",
    "BindingPort": 51001
  },
  "Kafka": {
    "ServiceName": "main",
    "ProvisionTopics": true
  },
  "Validation": {
    "Results": {
      "Timeout": "00:03:00",
      "MaxConcurrentComputations": 1,
      "MaxRowsPerRead": 100000,
      "Exclusions": "Strict",
      "MaxExcludedShare": 0.05,
      "RequestTimeout": "00:01:30",
      "FreezeInterval": "00:01:00",
      "FreezeRetryAfter": "01:00:00"
    }
  }
}
