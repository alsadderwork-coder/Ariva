{
  "Application": {
    "BindingHost": "0.0.0.0",
    "BindingPort": 8080
  },
  "Auth": {
    "IntegrationTokens": {
      "SigningKeyPath": "/app/secrets/integration-token-signing/signing.key",
      "PublicKeyPaths": [
        "/app/secrets/integration-token-public/public.pem",
        "/app/secrets/integration-token-public/previous.pem"
      ]
    }
  }
}
