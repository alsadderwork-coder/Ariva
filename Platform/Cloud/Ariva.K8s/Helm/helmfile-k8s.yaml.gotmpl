# Ariva releases for a Kubernetes cluster (Helmfile 1.x; .gotmpl because the file is templated).
# Pick the environment with -e: dev, demo, prd or localk8s; each selects its values file.
#   helmfile -f Platform/Cloud/Ariva.K8s/Helm/helmfile-k8s.yaml.gotmpl -e dev apply
# The release pipeline passes the namespace, kube context and, for prd, --state-values-set buildNumber=...
# (see Platform/Cloud/Ariva.Cicd/AzureDevOps/K8s/Release-ariva-k8s-dev.yaml).

# timescaledb: install the Ariva TimescaleDB release (Charts/timescaledb, ARV-062). Set it to false for a site whose
# PostgreSQL with TimescaleDB is provided another way (an operator with replication, or the customer's own server) and
# point Database:Host at it; the platform release then has no dependency on it.
environments:
  dev:
    values:
      - valuesFile: values-k8s-dev.yaml
        timescaledb: true
  demo:
    values:
      - valuesFile: values-k8s-demo.yaml
        timescaledb: true
  prd:
    values:
      - valuesFile: values-k8s-prd.yaml
        timescaledb: true
  localk8s:
    values:
      - valuesFile: values-localk8s.yaml
        timescaledb: true

helmDefaults:
  kubeContext: default

---

releases:

  # TimescaleDB (single node, ARV-062). Applied first and waited for: the platform's migration job connects to it.
  # Needs the timescaledb-credentials secret (superuser-password, migration-password) in the namespace beforehand.
  - name: timescaledb
    chart: ./Charts/timescaledb
    installed: {{ .Values.timescaledb }}
    wait: true
    timeout: 900
    values:
      - ./Charts/timescaledb/values.yaml

  # Ariva platform: api hosts, simulation and web, with the migration and Kafka topics jobs as hooks
  - name: ariva-platform
    chart: ./Charts/platform
    {{- if .Values.timescaledb }}
    needs:
      - timescaledb
    {{- end }}
    values:
      - ./Charts/platform/{{ .Values.valuesFile }}
    {{- if .Values | get "buildNumber" "" }}
    set:
      - name: buildNumber
        value: {{ .Values.buildNumber | quote }}
    {{- end }}

# Kafka and Redis
# Ariva does not ship its own Kafka or Redis releases. Either:
#   1. reuse AMAN's cluster releases in the same cluster: Ariva topics are prefixed "ariva." and Redis
#      keys use the "ariva:" instance name, so they never collide with AMAN's; point Kafka:BootstrapServers
#      and Redis:ConnectionString in appsettings.base.k8s-*.json at AMAN's services; or
#   2. deploy dedicated releases from AMAN's chart values (Aman.K8s Helm/Charts/kafka, which uses the
#      kubelauncher chart 0.1.19, and Helm/Charts/redis) copied into ./Charts and added as releases here.
