# Ariva releases for a Kubernetes cluster (Helmfile 1.x; .gotmpl because the file is templated).
# Pick the environment with -e: dev, demo, prd or localk8s; each selects its values file.
#   helmfile -f Platform/Cloud/Ariva.K8s/Helm/helmfile-k8s.yaml.gotmpl -e dev apply
# The release pipeline passes the namespace, kube context and, for prd, --state-values-set buildNumber=...
# (see Platform/Cloud/Ariva.Cicd/AzureDevOps/K8s/Release-ariva-k8s-dev.yaml).

# timescaledb: install the Ariva TimescaleDB release (Charts/timescaledb, ARV-062). Set it to false for a site whose
# PostgreSQL with TimescaleDB is provided another way (an operator with replication, or the customer's own server) and
# point Database:Host at it; the platform release then has no dependency on it.
# timescaledbTls: run that release with TLS (ARV-082a; Charts/timescaledb tls.enabled, TLS 1.2 at least, TCP over TLS
# only). On in prd, where every host verifies the server against the ariva-database-ca secret and refuses to start without
# it; prd refuses to render with it off. Off elsewhere, where a site's own values may still turn tls.enabled on. With it on,
# create the kubernetes.io/tls secret timescaledb-tls in the namespace first (Charts/timescaledb/values.yaml).
# podTls: the platform release with pod TLS (ARV-082b; Charts/platform podTls.enabled): every pod serves TLS from its own
# certificate and the ingress verifies it against the cluster CA. On in prd, which refuses to render with it off; the release
# sets podTls.enabled, so no values file turns it off there. Off elsewhere. The secrets' names (podTls.caSecretName,
# podTls.secretNames) come from the platform values file; create the secrets in the namespace first (Charts/platform/values.yaml).
# networkPolicies: the platform release with its NetworkPolicies (ARV-085; Charts/platform networkPolicies.enabled): every Ariva
# pod denies all traffic but the firewall matrix's flows. On in prd, which refuses to render with it off; the release sets
# networkPolicies.enabled, so no values file turns it off there. Off elsewhere. The peers (kube-dns, the database, Kafka, Redis,
# the collector, the relay, the outbound endpoints) come from the platform values file (Charts/platform/values.yaml).
# logShipping: the platform release requires log shipping (ARV-091a; Charts/platform logging): a log collector over TLS
# (logging.collector otlp or loki) and the log pseudonym key from a Secret (logging.pseudonymKeySecret). On in prd, which refuses
# to render with it off; the release sets logging.required, so no values file drops either there. Off elsewhere. The collector
# and the Secret's name come from the platform values file; create the Secret in the namespace first.
# databaseMaxConnections: the database's max_connections (ARV-232), set on the timescaledb release (maxConnections) and on the
# platform release (databaseConnections.serverMaxConnections) from this one value, so the platform chart's check of every
# replica's connections reads the server's real limit. 200 holds one replica of each host with a rolling update's extra pods;
# prd's HPA maxima need 400 (wiki 04, "Database connections"). For a site's own PostgreSQL, set it to what that server allows.
# uploadScan: the platform release scans every upload with clamd beside api-main (ARV-092c; Charts/platform uploadScan, on
# by default in every values file). On in prd, which refuses to render with it off; the release sets uploadScan.enabled, so
# no values file turns it off there. Off elsewhere means only that the release does not force it. In prd the site's values
# choose the signature source (uploadScan.signatures.source, wiki/04 section 6.7), or the chart refuses the release.
environments:
  dev:
    values:
      - valuesFile: values-k8s-dev.yaml
        databaseMaxConnections: 200
        timescaledb: true
        timescaledbTls: false
        podTls: false
        networkPolicies: false
        logShipping: false
        uploadScan: false
  demo:
    values:
      - valuesFile: values-k8s-demo.yaml
        databaseMaxConnections: 200
        timescaledb: true
        timescaledbTls: false
        podTls: false
        networkPolicies: false
        logShipping: false
        uploadScan: false
  prd:
    values:
      - valuesFile: values-k8s-prd.yaml
        databaseMaxConnections: 400
        timescaledb: true
        timescaledbTls: true
        podTls: true
        networkPolicies: true
        logShipping: true
        uploadScan: true
  localk8s:
    values:
      - valuesFile: values-localk8s.yaml
        databaseMaxConnections: 200
        timescaledb: true
        timescaledbTls: false
        podTls: false
        networkPolicies: false
        logShipping: false
        uploadScan: false

helmDefaults:
  kubeContext: default

---
{{- if and (eq .Environment.Name "prd") .Values.timescaledb (not (.Values | get "timescaledbTls" false)) }}
{{- fail "prd runs TimescaleDB with TLS: the hosts verify the server and refuse to start without it (state value timescaledbTls true; ARV-082a)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "podTls" false)) }}
{{- fail "prd serves the pods over TLS: the hosts listen on HTTPS only and the ingress verifies them (state value podTls true; ARV-082b)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "networkPolicies" false)) }}
{{- fail "prd isolates every pod: default deny and the firewall matrix's flows only (state value networkPolicies true; ARV-085)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "logShipping" false)) }}
{{- fail "prd ships the hosts' logs to a collector over TLS, with the log pseudonym key from a Secret (state value logShipping true; ARV-091a)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "uploadScan" false)) }}
{{- fail "prd scans every upload for malware with clamd beside api-main (state value uploadScan true; ARV-092c)" }}
{{- end }}

releases:

  # TimescaleDB (single node, ARV-062). Applied first and waited for: the platform's migration job connects to it.
  # Needs the timescaledb-credentials secret (superuser-password, migration-password) in the namespace beforehand, and with
  # timescaledbTls the timescaledb-tls secret (tls.crt, tls.key).
  - name: timescaledb
    chart: ./Charts/timescaledb
    installed: {{ .Values.timescaledb }}
    wait: true
    timeout: 900
    values:
      - ./Charts/timescaledb/values.yaml
    set:
      # The platform release checks its replicas against the same number (ARV-232)
      - name: maxConnections
        value: {{ .Values.databaseMaxConnections }}
      {{- if .Values | get "timescaledbTls" false }}
      # set, so that no values file turns TLS off (ARV-082a)
      - name: tls.enabled
        value: true
      {{- end }}

  # Ariva platform: api hosts, simulation and web, with the migration and Kafka topics jobs as hooks
  - name: ariva-platform
    chart: ./Charts/platform
    {{- if .Values.timescaledb }}
    needs:
      - timescaledb
    {{- end }}
    values:
      - ./Charts/platform/{{ .Values.valuesFile }}
    set:
      # The database's max_connections, as the timescaledb release sets it (ARV-232)
      - name: databaseConnections.serverMaxConnections
        value: {{ .Values.databaseMaxConnections }}
      {{- if .Values | get "buildNumber" "" }}
      - name: buildNumber
        value: {{ .Values.buildNumber | quote }}
      {{- end }}
      {{- if .Values | get "podTls" false }}
      # set, so that no values file turns pod TLS off (ARV-082b)
      - name: podTls.enabled
        value: true
      {{- end }}
      {{- if .Values | get "networkPolicies" false }}
      # set, so that no values file turns the network policies off (ARV-085)
      - name: networkPolicies.enabled
        value: true
      {{- end }}
      {{- if .Values | get "logShipping" false }}
      # set, so that no values file drops the log collector or the log pseudonym key's Secret (ARV-091a)
      - name: logging.required
        value: true
      {{- end }}
      {{- if .Values | get "uploadScan" false }}
      # set, so that no values file turns the malware scan off (ARV-092c)
      - name: uploadScan.enabled
        value: true
      {{- end }}

# Kafka and Redis
# Ariva does not ship its own Kafka or Redis releases. Either:
#   1. reuse AMAN's cluster releases in the same cluster: Ariva topics are prefixed "ariva." and Redis
#      keys use the "ariva:" instance name, so they never collide with AMAN's; point Kafka:BootstrapServers
#      and Redis:ConnectionString in appsettings.base.k8s-*.json at AMAN's services; or
#   2. deploy dedicated releases from AMAN's chart values (Aman.K8s Helm/Charts/kafka, which uses the
#      kubelauncher chart 0.1.19, and Helm/Charts/redis) copied into ./Charts and added as releases here.
