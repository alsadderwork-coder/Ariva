{
  "alert": "AMAN feed stopped (${environment})",
  "alertType": "METRIC_BASED_ALERT",
  "description": "A border site's AMAN feed unheard for T_stale (the heartbeat the desk feed stores per site, ARV-257): its desk states and service rates go stale. Also fires, naming no site, when no Stream replica reports any site's feed age (border deployments; ARV-125b).",
  "ruleType": "threshold_rule",
  "version": "v5",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "ariva.border.feed_age_seconds",
                "timeAggregation": "max",
                "spaceAggregation": "max"
              }
            ],
            "filter": {
              "expression": "deployment.environment = '${environment}'"
            },
            "groupBy": [
              {
                "name": "site",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ]
          }
        }
      ],
      "unit": "s"
    },
    "alertOnAbsent": true,
    "absentFor": "${amanFeedStale.minutes}",
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "${amanFeedStale.severity}",
          "op": "above",
          "matchType": "last",
          "target": "${amanFeedStale.seconds}",
          "channels": "${channels}"
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "${amanFeedStale.minutes}m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "site"
    ],
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing",
        "nodata"
      ]
    },
    "usePolicy": false
  },
  "labels": {
    "product": "ariva",
    "rule": "amanFeedStale",
    "environment": "${environment}",
    "severity": "${amanFeedStale.severity}"
  },
  "annotations": {
    "summary": "AMAN feed stopped at site {{$site}} (no site named: no Stream replica reports the feed age)",
    "description": "The AMAN feed of site {{$site}} has not been heard for {{$value}} seconds, more than ${amanFeedStale.minutes} minutes. With no site named, no Stream replica has reported any site's feed age for ${amanFeedStale.minutes} minutes: Stream down, its desk feed off, or the database out of its reach.",
    "runbook": "wiki/10-Operations-Runbook.md#44-aman-feed-stopped-border-deployments"
  },
  "disabled": false
}
