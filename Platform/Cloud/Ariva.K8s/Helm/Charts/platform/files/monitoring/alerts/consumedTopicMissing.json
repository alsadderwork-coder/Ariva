{
  "alert": "Ariva consumed topic missing (${environment})",
  "alertType": "METRIC_BASED_ALERT",
  "description": "A topic a host consumes does not exist, so its consumer waits (ARV-176, ARV-125b).",
  "ruleType": "threshold_rule",
  "version": "v5",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "ariva.kafka.consumed_topic_missing",
                "timeAggregation": "max",
                "spaceAggregation": "max"
              }
            ],
            "filter": {
              "expression": "deployment.environment = '${environment}'"
            },
            "groupBy": [
              {
                "name": "topic",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "group",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "service.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "legend": "{{topic}} ({{group}})"
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "${consumedTopicMissing.severity}",
          "op": "above_or_equal",
          "matchType": "all_the_times",
          "target": 1,
          "channels": "${channels}"
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "${consumedTopicMissing.minutes}m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "topic",
      "group",
      "service.name"
    ],
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": false
  },
  "labels": {
    "product": "ariva",
    "rule": "consumedTopicMissing",
    "environment": "${environment}",
    "severity": "${consumedTopicMissing.severity}"
  },
  "annotations": {
    "summary": "Ariva consumed topic missing: {{$topic}}",
    "description": "Ariva consumed topic missing for {{$group}} on {{$service.name}} for ${consumedTopicMissing.minutes} minutes.",
    "runbook": "wiki/10-Operations-Runbook.md#45a-outbox-backlog-and-dead-letters-arv-020"
  },
  "disabled": false
}
