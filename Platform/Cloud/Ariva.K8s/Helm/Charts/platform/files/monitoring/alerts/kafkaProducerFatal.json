{
  "alert": "Ariva Kafka producer fatal error (${environment})",
  "alertType": "METRIC_BASED_ALERT",
  "description": "A host's Kafka producer raised a fatal error or was recreated after one (ARV-167, ARV-125b).",
  "ruleType": "threshold_rule",
  "version": "v5",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "stepInterval": 60,
            "aggregations": [
              {
                "metricName": "ariva.kafka.producer_fatal",
                "timeAggregation": "increase",
                "spaceAggregation": "sum"
              }
            ],
            "filter": {
              "expression": "deployment.environment = '${environment}'"
            },
            "groupBy": [
              {
                "name": "service.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              },
              {
                "name": "kind",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "legend": "{{service.name}} {{kind}}"
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "${kafkaProducerFatal.severity}",
          "op": "above",
          "matchType": "in_total",
          "target": 0,
          "channels": "${channels}"
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "${kafkaProducerFatal.minutes}m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "service.name",
      "kind"
    ],
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": false
  },
  "labels": {
    "product": "ariva",
    "rule": "kafkaProducerFatal",
    "environment": "${environment}",
    "severity": "${kafkaProducerFatal.severity}"
  },
  "annotations": {
    "summary": "Kafka producer of {{$service.name}}: {{$kind}}",
    "description": "The Kafka producer of {{$service.name}} counted {{$value}} {{$kind}} in the last ${kafkaProducerFatal.minutes} minutes.",
    "runbook": "wiki/10-Operations-Runbook.md#45a-outbox-backlog-and-dead-letters-arv-020"
  },
  "disabled": false
}
