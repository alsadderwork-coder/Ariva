# Ariva releases from an offline install bundle (ARV-127; wiki/04 section 12). scripts/offline/bundle.mjs copies this file
# into the bundle as helm/helmfile.yaml.gotmpl, next to the packaged charts (charts/) and the values files (values/: the
# environment values of the platform chart, the database chart's values, images.yaml with the bundle's build number, release
# version and image digests, timescaledb-image.yaml with the chart's TimescaleDB tag and digest, and clamav-image.yaml with the
# platform chart's ClamAV tag and digest). Same releases and environments as helmfile-k8s.yaml.gotmpl; chart-security.mjs
# renders both from a staged bundle and requires the same objects.
# Install only a bundle that scripts/offline/verify.mjs passed without --dry-run (wiki/04 section 12.3).
#
#   helmfile -f helm/helmfile.yaml.gotmpl -e prd --state-values-set mirror=<registry>[/<path>] \
#     [--state-values-set siteValues=<absolute path>] [--state-values-set databaseValues=<absolute path>] template
#
# State values:
#   mirror          required: the site's registry mirror the bundle's images were copied to, host[:port][/path] in lower
#                   case; Ariva's images under <mirror>/ariva, TimescaleDB under <mirror>/timescale/timescaledb-ha, ClamAV
#                   under <mirror>/clamav/clamav.
#   siteValues      the site's values file for the platform release (domain, ingresses, clusterName, otel, logging, image credentials)
#   databaseValues  the site's values file for the TimescaleDB release (storage, resources)
#   timescaledb     false where PostgreSQL with TimescaleDB is provided another way, as in helmfile-k8s.yaml.gotmpl
#   databaseMaxConnections  the database's max_connections (ARV-232), as in helmfile-k8s.yaml.gotmpl: set on the timescaledb
#                   release (maxConnections) and the platform release (databaseConnections.serverMaxConnections); 200, and 400
#                   in prd. A site raises it here (--state-values-set) with its replicas or for its own PostgreSQL
#   timescaledbTls  TimescaleDB with TLS (ARV-082a), as in helmfile-k8s.yaml.gotmpl: true in prd, which refuses it off; a
#                   site file cannot turn it off there (the release sets tls.enabled); create timescaledb-tls first
#   podTls          the pods over TLS (ARV-082b), as in helmfile-k8s.yaml.gotmpl: true in prd, which refuses it off; a site
#                   file cannot turn it off there (the release sets podTls.enabled) but may name the secrets
#                   (podTls.caSecretName, podTls.secretNames); create them first
#   networkPolicies the NetworkPolicies (ARV-085), as in helmfile-k8s.yaml.gotmpl: true in prd, which refuses it off; a site
#                   file cannot turn them off there (the release sets networkPolicies.enabled) but gives the peers
#                   (networkPolicies.*, ingressController) and ingressController.podNetworks
#   logShipping     log shipping (ARV-091a), as in helmfile-k8s.yaml.gotmpl: true in prd, which refuses it off; a site file
#                   cannot drop the collector or the log pseudonym key's Secret there (the release sets logging.required) but
#                   chooses them (logging.collector, logging.pseudonymKeySecret); create the Secret first
#   uploadScan      the malware scan beside api-main (ARV-092c), as in helmfile-k8s.yaml.gotmpl: true in prd, which refuses it
#                   off; a site file cannot turn it off there (the release sets uploadScan.enabled) but chooses how the
#                   signatures arrive, which a site without internet sets to mirror or mounted (uploadScan.signatures,
#                   wiki/04 sections 6.7 and 12.4); ClamAV's image comes from <mirror>/clamav/clamav under the chart's tag
#                   and digest (values/clamav-image.yaml, listed last)
# The image repository, tags and digests come from the bundle and win over a site file: the pods pull exactly the images the
# bundle's verification checked. It refuses to render unless images.yaml pins all seven Ariva digests, so a dry run's bundle
# (which pins none) cannot be installed.

environments:
  dev:
    values:
      - valuesFile: values-k8s-dev.yaml
        databaseMaxConnections: 200
        timescaledb: true
        timescaledbTls: false
        podTls: false
        networkPolicies: false
        logShipping: false
        uploadScan: false
  demo:
    values:
      - valuesFile: values-k8s-demo.yaml
        databaseMaxConnections: 200
        timescaledb: true
        timescaledbTls: false
        podTls: false
        networkPolicies: false
        logShipping: false
        uploadScan: false
  prd:
    values:
      - valuesFile: values-k8s-prd.yaml
        databaseMaxConnections: 400
        timescaledb: true
        timescaledbTls: true
        podTls: true
        networkPolicies: true
        logShipping: true
        uploadScan: true
  localk8s:
    values:
      - valuesFile: values-localk8s.yaml
        databaseMaxConnections: 200
        timescaledb: true
        timescaledbTls: false
        podTls: false
        networkPolicies: false
        logShipping: false
        uploadScan: false

helmDefaults:
  kubeContext: default

---
{{- $mirror := .Values | get "mirror" "" }}
{{- if not (regexMatch "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?(:[0-9]{1,5})?(/[a-z0-9]([a-z0-9._-]{0,126}[a-z0-9])?){0,3}$" $mirror) }}
{{- fail "set the state value mirror to the site's registry mirror that holds the bundle's images (host[:port][/path], lower case)" }}
{{- end }}
{{- $images := readFile "values/images.yaml" | fromYaml }}
{{- range $service := list "api-main" "api-ingest" "api-stream" "api-cronz" "api-integration" "simulation" "web" }}
{{- if not (regexMatch "^sha256:[0-9a-f]{64}$" (index ($images.imageDigests | default dict) $service | toString)) }}
{{- fail (printf "values/images.yaml pins no digest for %s: a dry run bundle cannot be installed (install only a bundle verify.mjs passed without --dry-run)" $service) }}
{{- end }}
{{- end }}
{{- if and (eq .Environment.Name "prd") .Values.timescaledb (not (.Values | get "timescaledbTls" false)) }}
{{- fail "prd runs TimescaleDB with TLS: the hosts verify the server and refuse to start without it (state value timescaledbTls true; ARV-082a)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "podTls" false)) }}
{{- fail "prd serves the pods over TLS: the hosts listen on HTTPS only and the ingress verifies them (state value podTls true; ARV-082b)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "networkPolicies" false)) }}
{{- fail "prd isolates every pod: default deny and the firewall matrix's flows only (state value networkPolicies true; ARV-085)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "logShipping" false)) }}
{{- fail "prd ships the hosts' logs to a collector over TLS, with the log pseudonym key from a Secret (state value logShipping true; ARV-091a)" }}
{{- end }}
{{- if and (eq .Environment.Name "prd") (not (.Values | get "uploadScan" false)) }}
{{- fail "prd scans every upload for malware with clamd beside api-main (state value uploadScan true; ARV-092c)" }}
{{- end }}

releases:

  # TimescaleDB (single node, ARV-062), its image from the mirror under the digest the chart pins.
  - name: timescaledb
    chart: ./charts/ariva-timescaledb.tgz
    installed: {{ .Values.timescaledb }}
    wait: true
    timeout: 900
    values:
      - ./values/timescaledb.yaml
      {{- with .Values | get "databaseValues" "" }}
      - {{ . | quote }}
      {{- end }}
      # last, so the chart's pinned tag and digest win over the site's file
      - ./values/timescaledb-image.yaml
    set:
      - name: image.repository
        value: {{ printf "%s/timescale/timescaledb-ha" $mirror | quote }}
      # The platform release checks its replicas against the same number (ARV-232)
      - name: maxConnections
        value: {{ .Values.databaseMaxConnections }}
      {{- if .Values | get "timescaledbTls" false }}
      # set, so that no site file turns TLS off (ARV-082a)
      - name: tls.enabled
        value: true
      {{- end }}

  # Ariva platform: api hosts, simulation and web, with the migration and Kafka topics jobs as hooks
  - name: ariva-platform
    chart: ./charts/ariva-platform.tgz
    {{- if .Values.timescaledb }}
    needs:
      - timescaledb
    {{- end }}
    values:
      - ./values/{{ .Values.valuesFile }}
      {{- with .Values | get "siteValues" "" }}
      - {{ . | quote }}
      {{- end }}
      # last, so the bundle's release version, build number and digests win over the site's file
      - ./values/images.yaml
      # and the ClamAV image's tag and digest, the chart's pin (ARV-092c)
      - ./values/clamav-image.yaml
    set:
      - name: imageRepository
        value: {{ printf "%s/ariva" $mirror | quote }}
      # The database's max_connections, as the timescaledb release sets it (ARV-232)
      - name: databaseConnections.serverMaxConnections
        value: {{ .Values.databaseMaxConnections }}
      # the scanner beside api-main from the mirror too (ARV-092c), under the tag and digest of clamav-image.yaml
      - name: uploadScan.image.repository
        value: {{ printf "%s/clamav/clamav" $mirror | quote }}
      {{- if .Values | get "podTls" false }}
      # set, so that no site file turns pod TLS off (ARV-082b)
      - name: podTls.enabled
        value: true
      {{- end }}
      {{- if .Values | get "networkPolicies" false }}
      # set, so that no site file turns the network policies off (ARV-085)
      - name: networkPolicies.enabled
        value: true
      {{- end }}
      {{- if .Values | get "logShipping" false }}
      # set, so that no site file drops the log collector or the log pseudonym key's Secret (ARV-091a)
      - name: logging.required
        value: true
      {{- end }}
      {{- if .Values | get "uploadScan" false }}
      # set, so that no site file turns the malware scan off (ARV-092c)
      - name: uploadScan.enabled
        value: true
      {{- end }}
