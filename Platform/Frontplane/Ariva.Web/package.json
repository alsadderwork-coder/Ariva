{
	"name": "ariva.sveltekit",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --open",
		"dev:apphost": "vite dev --strictPort",
		"build": "vite build && node scripts/postbuild-nginx.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.4",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"prettier": "3.3.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.0.5",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/noto-sans-arabic": "^5.3.0",
		"@microsoft/signalr": "8.0.17",
		"echarts": "^6.0.0",
		"qrcode-generator": "1.4.4",
		"svelte": "^5.57.1",
		"svelte-i18n": "^4.0.1",
		"zod": "^4.0.17"
	},
	"overrides": {
		"runed": "0.38.0",
		"svelte-i18n": {
			"esbuild": "^0.25.12"
		}
	}
}
