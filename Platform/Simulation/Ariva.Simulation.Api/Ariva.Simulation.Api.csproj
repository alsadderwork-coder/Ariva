<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
        <UserSecretsId>05368ca2-4f1e-4db6-9235-9e8bd7260258</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..\..</DockerfileContext>
        <DockerfileTag>ariva-simulation</DockerfileTag>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DocumentationFile>bin\Debug\net10.0\Ariva.Simulation.Api.xml</DocumentationFile>
        <NoWarn>1701;1702;1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DocumentationFile>bin\Release\net10.0\Ariva.Simulation.Api.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\..\Backplane\Ariva.Api.Common\appsettings.base.json">
            <Link>appsettings.base.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\Backplane\Ariva.Api.Common\appsettings.base.vm-local.json">
            <Link>appsettings.base.vm-local.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\Backplane\Ariva.Api.Common\appsettings.base.k8s-dev.json">
            <Link>appsettings.base.k8s-dev.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\Backplane\Ariva.Api.Common\appsettings.base.k8s-demo.json">
            <Link>appsettings.base.k8s-demo.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\Backplane\Ariva.Api.Common\appsettings.base.k8s-prd.json">
            <Link>appsettings.base.k8s-prd.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.service.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.service.vm-local.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.service.k8s-dev.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.service.k8s-demo.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="appsettings.service.k8s-prd.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="environment.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Compile Remove="Logs\**" />
        <EmbeddedResource Remove="Logs\**" />
        <Content Remove="Logs\**" />
        <None Remove="Logs\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\GlobalSuppressions.cs" Link="GlobalSuppressions.cs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ariva.UnitTests" />
        <InternalsVisibleTo Include="Ariva.IntegrationTests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Business\Ariva.Business.Contracts\Ariva.Business.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The emulated AMAN publishes its feed topics with a plain producer, as a partner system would (ARV-029). -->
        <PackageReference Include="Confluent.Kafka" />
    </ItemGroup>

</Project>
