<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for every restore in the repository: the solution, the local tools (.config/dotnet-tools.json and
     Ariva.UnitTests' Stryker manifest), the Aspire AppHost SDK, CI and the image builds (each Dockerfile copies this file
     before its restore). ARV-096 (ASVS 5.0 V15.1.2, supply chain): nuget.org is the only source, and package source mapping
     sends every package id to it, so a source added in a user or machine NuGet.Config never serves an Ariva package. The
     lock files (packages.lock.json, Directory.Build.props) pin the versions it serves. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
