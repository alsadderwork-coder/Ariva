<Project>
    <PropertyGroup>
        <!-- Fix file locking issues -->
        <UseAppHost>true</UseAppHost>

        <!-- Common settings for all projects -->
        <TargetFramework>net10.0</TargetFramework>
		 <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		  <BuildInParallel>false</BuildInParallel>
		   <UseSharedCompilation>false</UseSharedCompilation>
		    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <LangVersion>14</LangVersion>
          <UseRazorBuildServer>false</UseRazorBuildServer>
        <!-- Improve build performance -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup Label="Security analysis">
        <!-- Roslyn security analyzers ship with the SDK; severities for the CWE rules are set in .editorconfig -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisModeSecurity>All</AnalysisModeSecurity>
        <!-- CWE-120: no unsafe code anywhere; scripts/security/scan.mjs also fails the build gate on the unsafe keyword -->
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup Label="Local development settings" Condition="('$(MSBuildProjectName.StartsWith(`Ariva.Api.`))' == 'true' And '$(MSBuildProjectName)' != 'Ariva.Api.Common') Or '$(MSBuildProjectName)' == 'Ariva.Simulation.Api'">
        <!-- Written by scripts/dev-up.mjs (ARV-003); copied only when it exists, so builds elsewhere never see it -->
        <Content Include="$(MSBuildThisFileDirectory)Platform/Backplane/Ariva.Api.Common/appsettings.local.json" Condition="Exists('$(MSBuildThisFileDirectory)Platform/Backplane/Ariva.Api.Common/appsettings.local.json')">
            <Link>appsettings.local.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <!-- SkiaSharp (ARV-142a, advertisement images) brings native libraries for 13 Linux runtimes, three Windows ones (each with
         about 95 MB of native debug symbols) and macOS. A build without a runtime identifier (development and tests) keeps
         the runtimes Ariva builds and runs on (linux-x64, linux-arm64, win-x64, osx) without the symbols; a publish for one
         runtime (the images: linux-x64) takes that runtime's library only, so this target does not run for it. -->
    <Target Name="ArivaTrimSkiaSharpNativeAssets" AfterTargets="ResolvePackageAssets" Condition="'$(RuntimeIdentifier)' == ''">
        <ItemGroup>
            <_ArivaSkiaSharpNative Include="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(NuGetPackageId)').StartsWith('SkiaSharp.NativeAssets'))" />
            <_ArivaSkiaSharpDropped Include="@(_ArivaSkiaSharpNative)" Condition="'%(Extension)' == '.pdb' Or ('%(RuntimeIdentifier)' != 'linux-x64' And '%(RuntimeIdentifier)' != 'linux-arm64' And '%(RuntimeIdentifier)' != 'win-x64' And '%(RuntimeIdentifier)' != 'osx')" />
            <RuntimeTargetsCopyLocalItems Remove="@(_ArivaSkiaSharpDropped)" />
        </ItemGroup>
    </Target>
</Project>
