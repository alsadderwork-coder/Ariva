# Local development settings for docker-compose.dev.yml (ARV-003).
# scripts/dev-up.mjs copies this file to .env on first run and replaces every "generate" value with a random
# password. .env is git-ignored; never commit it. Ports default away from AMAN's local stack.
ARIVA_DB_PORT=5433
ARIVA_DB_PASSWORD=generate
ARIVA_DB_READONLY_PASSWORD=generate
ARIVA_KAFKA_PORT=19092
ARIVA_REDIS_PORT=16379
ARIVA_REDIS_PASSWORD=generate
ARIVA_SMTP_PORT=2525
ARIVA_SMTP_UI_PORT=5080
